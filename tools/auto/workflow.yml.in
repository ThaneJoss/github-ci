# Generated by tools/auto/render.py; edit its sources, then regenerate.
name: Automatic project checks
'on':
  workflow_call:
    inputs:
      working-directory:
        type: string
        default: .
      timeout-minutes:
        type: number
        default: 15
      overrides:
        description: Internal transport from ci.yml; callers normally use no inputs.
        type: string
        default: '{}'
    outputs:
      quality-passed:
        value: ${{ jobs.quality.outputs.quality-passed }}
permissions:
  contents: read
jobs:
  quality:
    name: Quality
    runs-on: ubuntu-24.04
    timeout-minutes: ${{ inputs.timeout-minutes }}
    outputs:
      quality-passed: ${{ steps.complete.outputs.quality-passed }}
    defaults:
      run:
        shell: bash
    env:
      CI: 'true'
      npm_config_fetch_retries: '1'
      npm_config_fetch_retry_mintimeout: '1000'
      npm_config_fetch_retry_maxtimeout: '10000'
      npm_config_ignore_scripts: 'true'
      # pnpm 10 drops lowercase npm_* false values in nested script environments.
      NPM_CONFIG_ENABLE_PRE_POST_SCRIPTS: 'false'
      NPM_CONFIG_MANAGE_PACKAGE_MANAGER_VERSIONS: 'false'
      npm_config_engine_strict: 'true'
      # pnpm >=11 no longer reads npm_config_*; retain the same policy for both.
      pnpm_config_fetch_retries: '1'
      pnpm_config_fetch_retry_mintimeout: '1000'
      pnpm_config_fetch_retry_maxtimeout: '10000'
      pnpm_config_ignore_scripts: 'true'
      pnpm_config_enable_pre_post_scripts: 'false'
      pnpm_config_pm_on_fail: error
      pnpm_config_engine_strict: 'true'
      UV_HTTP_RETRIES: '1'
      UV_HTTP_TIMEOUT: '30'
      UV_PYTHON_DOWNLOADS: never
      UV_NO_PROGRESS: '1'
      CUDA_VISIBLE_DEVICES: ''
      HF_HUB_OFFLINE: '1'
      TRANSFORMERS_OFFLINE: '1'
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Prepare temporary controller and download stores
        run: |
          printf 'CI_AUTO_DIR=%s/github-ci-auto\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'CI_NODE_STORE=%s/github-ci-node-store\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'npm_config_cache=%s/github-ci-npm-cache\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
          printf 'UV_CACHE_DIR=%s/github-ci-uv-cache\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Discover standard project metadata
        id: discover
        env:
          CI_WORKING_DIRECTORY: ${{ inputs.working-directory }}
          CI_TIMEOUT: ${{ inputs.timeout-minutes }}
          CI_OVERRIDES: ${{ inputs.overrides }}
        run: |
          set -euo pipefail
          mkdir -p "$CI_AUTO_DIR"
          # Embedded in the called workflow: no caller script path or mutable template ref.
          cat > "$CI_AUTO_DIR/runtime.py" <<'PY_RUNTIME'
@@RUNTIME@@
          PY_RUNTIME
          cat > "$CI_AUTO_DIR/formats.py" <<'PY_FORMATS'
@@FORMATS@@
          PY_FORMATS
          cat > "$CI_AUTO_DIR/requirements-formats.txt" <<'format_requirements'
@@FORMAT_REQUIREMENTS@@
          format_requirements
          /usr/bin/python3 -I "$CI_AUTO_DIR/runtime.py" detect
      - name: Set up declared Node
        id: node
        if: ${{ steps.discover.outputs.node-version != '' }}
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ steps.discover.outputs.node-version }}
          package-manager-cache: false
      - name: Set up declared Python
        id: python
        if: ${{ steps.discover.outputs.python-version != '' }}
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: ${{ steps.discover.outputs.python-version }}
      - name: Set up fixed uv (native lock and audit)
        if: ${{ steps.discover.outputs.uv == 'true' }}
        uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: '0.12.19'
          enable-cache: false
      - name: Cache Node download stores
        if: ${{ steps.discover.outputs.node-lock == 'true' }}
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            ${{ runner.temp }}/github-ci-node-store
            ${{ runner.temp }}/github-ci-npm-cache
          key: auto-v1-${{ runner.os }}-${{ runner.arch }}-node-${{ steps.node.outputs.node-version }}-${{ steps.discover.outputs.node-manager }}-${{ steps.discover.outputs.lock-key }}
      - name: Cache uv downloads (never the virtual environment)
        if: ${{ steps.discover.outputs.uv == 'true' }}
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ${{ runner.temp }}/github-ci-uv-cache
          key: auto-v1-${{ runner.os }}-${{ runner.arch }}-uv-0.12.19-python-${{ steps.python.outputs.python-version }}-${{ steps.discover.outputs.lock-key }}
      - name: Install frozen dependencies once
        run: /usr/bin/python3 -I "$CI_AUTO_DIR/runtime.py" install
      - name: Execute discovered checks and mandatory audits
        run: /usr/bin/python3 -I "$CI_AUTO_DIR/runtime.py" execute
      - name: Record successful completion
        id: complete
        run: echo 'quality-passed=true' >> "$GITHUB_OUTPUT"
      - name: Summarize executed and missing checks
        if: ${{ always() }}
        run: |
          if [[ -f "$CI_AUTO_DIR/runtime.py" ]]; then
            /usr/bin/python3 -I "$CI_AUTO_DIR/runtime.py" summary
          fi
      # No automatic failure artifacts: caller reports may contain secrets or datasets.
