{
  "name": "workspace-probe",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace-probe",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24 <25"
      }
    },
    "node_modules/workspace-math": {
      "resolved": "packages/math",
      "link": true
    },
    "node_modules/workspace-native": {
      "resolved": "packages/native",
      "link": true
    },
    "packages/math": {
      "name": "workspace-math",
      "version": "1.0.0"
    },
    "packages/native": {
      "name": "workspace-native",
      "version": "1.0.0"
    }
  }
}
